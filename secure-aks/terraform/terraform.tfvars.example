###############################################################################
# Example variable values. Copy to terraform.tfvars and edit.
#   cp terraform.tfvars.example terraform.tfvars
#
# NEVER commit a real terraform.tfvars — it is git-ignored.
###############################################################################

subscription_id = "00000000-0000-0000-0000-000000000000"

prefix      = "secaks"
environment = "poc"
location    = "westeurope"

# Entra ID group(s) that get cluster-admin via Azure RBAC. Local Kubernetes
# accounts are disabled, so you MUST supply at least one group you belong to.
admin_group_object_ids = [
  "11111111-1111-1111-1111-111111111111",
]

# Node sizing (adjust to your quota/budget).
system_node_vm_size   = "Standard_D2s_v5"
system_node_min_count = 2
system_node_max_count = 4

user_node_vm_size   = "Standard_D4s_v5"
user_node_min_count = 2
user_node_max_count = 6

# Requires: az feature register --namespace Microsoft.Compute --name EncryptionAtHost
enable_host_encryption = true

tags = {
  owner = "platform-team"
}
